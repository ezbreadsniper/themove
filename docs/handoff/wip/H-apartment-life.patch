+      curlFingers(p, L, 'Right', { fingers: 28 + 70 * f, thumb: 12 + 40 * f });
+      curlFingers(p, L, 'Left', { fingers: 20, thumb: 30 });
+      Pose.headNod(p, 4 * bump(t, 0.6, 1.3));
+      Pose.jawOpen(p, bump(t, 0.9, 1.5) * 6);
+      return p;
+    },
+  };
+}
+
+/** Big stretch with a yawn: arms up over the head, back arches, jaw wide; settles to idle frame 0. */
+function stretchYawn(bases) {
+  return {
+    duration: 4.6,
+    loop: false,
+    meta: standMeta({ then: 'idle' }),
+    events: [{ name: 'yawn', time: 1.3 }],
+    sample: (L, t) => {
+      const kk = kOf(L);
+      const up = envelope(t, 0.4, 1.6, 2.9, 3.9);
+      const p = standBody(L, { dip: -0.01 * up, fwd: -0.015 * up, ankles: {}, feet: { Left: { pitch: -6 * up }, Right: { pitch: -6 * up } } });
+      Pose.spineFlex(p, 'Spine1', -10 * up);
+      Pose.spineFlex(p, 'Spine2', -8 * up);
+      Pose.spineSide(p, 'Spine1', 4 * bump(t, 1.6, 2.9));
+      Pose.headNod(p, -22 * up);
+      Pose.jawOpen(p, 20 * envelope(t, 0.9, 1.5, 2.6, 3.3));
+      const fk = worldPose(L, p);
+      const top = fk.pos.Head.clone().add(V(0, 0.36 * kk, -0.03 * kk));
+      for (const side of SIDES) {
+        const s = S[side];
+        const at = top.clone().add(V(s * (0.06 + 0.04 * bump(t, 1.6, 2.9)) * kk, 0, 0));
+        reach(L, p, side, null, handTargetAt(L, side, at, V(-s * 0.7, 0.6, 0), V(0, 1, 0.2), V(s, 0.2, -0.6)), up, { arc: V(s * 0.25 * kk, 0, 0.12 * kk) });
+        curlFingers(p, L, side, { fingers: 28 - 18 * up, thumb: 12 });
+      }
+      const idle0 = relaxHands(bases.idle.sample(L, 0, bases.idle.duration), L);
+      return blend(L, p, idle0, ease(window01(t, 4.0, 4.6)) + (1 - ease(window01(t, 0, 0.35))) * 0);
+    },
+  };
+}
+
+/** Per-bone slerp to `b` by w (hips lerp). */
+function blend(L, a, b, w) {
+  if (w <= 0) return a;
+  relaxHands(a, L);
+  for (const name of new Set([...Object.keys(a.bones), ...Object.keys(b.bones)])) {
+    const qa = a.bones[name] ?? new THREE.Quaternion();
+    a.bones[name] = qa.clone().slerp(b.bones[name] ?? new THREE.Quaternion(), w);
+  }
+  a.hips.lerp(b.hips, w);
+  return a;
+}
+
+/**
+ * Fridge run: facing the open fridge ~0.55 m ahead: the left hand swings the door open, the right
+ * reaches in for a bottle ('grab' event: show the bottle), the door closes, the bottle comes to the
+ * chest. Ends on chill_stand_drink frame 0.
+ */
+function fridgeGrab(bases) {
+  return {
+    duration: 3.6,
+    loop: false,
+    meta: standMeta({ then: 'chill_stand_drink_1', props: { Right: 'bottle' }, propFrom: 1.55 }),
+    events: [{ name: 'open', time: 0.7 }, { name: 'grab', time: 1.55 }, { name: 'close', time: 2.45 }],
+    sample: (L, t) => {
+      const kk = kOf(L);
+      const reachIn = envelope(t, 0.85, 1.5, 1.7, 2.4);
+      const p = standBody(L, { fwd: 0.03 * reachIn, pitch: 8 * reachIn, ankles: { Right: L.world.RightFoot.clone().add(V(-0.02 * kk, 0, 0.05 * kk * ease(window01(t, 0.6, 1.0)))) } });
+      Pose.spineFlex(p, 'Spine1', 8 * reachIn);
+      Pose.headNod(p, 6 * reachIn);
+      Pose.headTurn(p, -6 * reachIn);
+      // Door handle: opens on an arc around a hinge on the left.
+      const open = ease(window01(t, 0.45, 1.0)) * (1 - ease(window01(t, 2.2, 2.7)));
+      const hinge = V(0.45 * kk, 1.08, 0.58);
+      const ang = open * 1.1;
+      const handle = hinge.clone().add(V(-Math.cos(ang) * 0.5, 0, -Math.sin(ang) * 0.5));
+      const onDoor = envelope(t, 0.2, 0.45, 2.7, 3.0);
+      reach(L, p, 'Left', null, handTargetAt(L, 'Left', handle, V(0, -1, 0.15), V(-0.4, 0, -1).applyAxisAngle(V(0, 1, 0), -ang), V(0.8, -0.6, -0.4)), onDoor);
+      curlFingers(p, L, 'Left', { fingers: 28 + 50 * onDoor, thumb: 12 + 25 * onDoor });
+      // Right: into the fridge, grab, then to the chest (the drink rest).
+      const fk = worldPose(L, p);
+      const shelf = V(-0.06 * kk, 1.0, 0.62);
+      const inFridge = propGrip(L, 'Right', 'bottle', propFrame(shelf, V(0, 1, 0), V(-0.4, 0, -1)), V(-0.7, -0.6, -0.5));
+      const chest = propGrip(L, 'Right', 'bottle', heldFrame('Right', fk.pos.Spine.clone().add(V(-0.17 * kk, -0.03 * kk, 0.18 * kk)), { tilt: 0.08 }), POLE.Right);
+      const toShelf = ease(window01(t, 0.95, 1.5));
+      const back = ease(window01(t, 1.75, 2.6));
+      if (back <= 0) reach(L, p, 'Right', null, inFridge, toShelf);
+      else reach(L, p, 'Right', inFridge, chest, back, { arc: V(0, 0.04, 0.02) });
+      const grabbed = ease(window01(t, 1.45, 1.6));
+      curlFingers(p, L, 'Right', { fingers: 28 + 44 * grabbed, thumb: 12 + 28 * grabbed });
+      const end = bases.chill_stand_drink_1 ? relaxHands(bases.chill_stand_drink_1.sample(L, 0, bases.chill_stand_drink_1.duration), L) : null;
+      return end ? blend(L, p, end, ease(window01(t, 3.0, 3.6))) : p;
+    },
+  };
+}
+
+/** Picking music at the media console (~0.45 m ahead, 0.48 m high): bent over, fingers on the gear. */
+function consolePick() {
+  const beats = 16;
+  return {
+    duration: beats * BEAT,
+    loop: true,
+    meta: standMeta({ beats, console: { distance: 0.45, top: 0.48 } }),
+    sample: (L, t) => {
+      const b = t / BEAT;
+      const kk = kOf(L);
+      const p = standBody(L, { fwd: -0.07, dip: 0.07, pitch: 26, ankles: { Left: L.world.LeftFoot.clone().add(V(0.04 * kk, 0, 0.04 * kk)), Right: L.world.RightFoot.clone().add(V(-0.04 * kk, 0, -0.06 * kk)) }, kneeOut: 0.3 });
+      Pose.spineFlex(p, 'Spine1', 14);
+      Pose.spineFlex(p, 'Spine2', 8);
+      Pose.headNod(p, 10);
+      groove(p, b, 5, { follow: 0.6 });
+      const flip = (ph) => Math.sin(((b / 4) + ph) * TAU);
+      const y = 0.52 + 0.06;
+      reach(L, p, 'Right', null, handTargetAt(L, 'Right', V(-0.12 * kk + flip(0) * 0.05 * kk, y + 0.02 * Math.max(0, flip(0.25)), 0.55), V(0.1, -0.5, 1), V(0.2, -1, 0.2), V(-0.8, -0.5, -0.5)), 1);
+      reach(L, p, 'Left', null, handTargetAt(L, 'Left', V(0.12 * kk, y, 0.5 + 0.02 * flip(0.5)), V(-0.1, -0.5, 1), V(-0.2, -1, 0.2), V(0.8, -0.5, -0.5)), 1);
+      SIDES.forEach((side) => curlFingers(p, L, side, { fingers: 35, thumb: 25 }));
+      return p;
+    },
+  };
+}
+
+// --- registry -------------------------------------------------------------------------------------
+
+function makeChillSamplers(bases) {
+  const out = {};
+  for (const [variant, sfx] of [['sofa', ''], ['chair', '_chair']]) {
+    for (const st of [1, 2, 3, 4]) out[`chill_sit_listen_${st}${sfx}`] = sitListen(variant, st);
+    out[`chill_sit_listen_bottle_1${sfx}`] = sitListen(variant, 1, { hold: 'bottle' });
+    out[`chill_sit_listen_bottle_4${sfx}`] = sitListen(variant, 4, { hold: 'bottle' });
+    for (const st of [1, 2, 3, 4]) out[`chill_sit_relaxed_${st}${sfx}`] = sitRelaxed(variant, st);
+    for (const st of [1, 2, 3]) out[`chill_sit_drink_${st}${sfx}`] = sitDrink(variant, st);
+    out[`chill_sit_drink_cup${sfx}`] = sitDrink(variant, 2, 'cup');
+    for (const side of SIDES) {
+      const d = side[0];
+      out[`chill_sit_talk_${d}${sfx}`] = sitTalk(variant, side, 'talk');
+      out[`chill_sit_listento_${d}${sfx}`] = sitTalk(variant, side, 'listen');
+      out[`chill_sit_talk_bottle_${d}${sfx}`] = sitTalk(variant, side, 'talk', { hold: 'bottle' });
+      out[`chill_sit_dap_${d}${sfx}`] = sitDap(variant, side);
+    }
+    for (const st of [1, 2]) out[`chill_sit_phone_${st}${sfx}`] = sitPhone(variant, st);
+    for (const st of [1, 2]) out[`chill_sit_game_${st}${sfx}`] = sitGame(variant, st);
+  }
+  out.chill_dance_twostep = danceTwoStep(1);
+  out.chill_dance_twostep_low = danceTwoStep(0.65);
+  out.chill_dance_twostep_bottle = danceTwoStep(0.8, { hold: 'bottle' });
+  out.chill_dance_bounce_1 = danceBounce(1, 1);
+  out.chill_dance_bounce_2 = danceBounce(2, 0.85);
+  out.chill_dance_bounce_3 = danceBounce(3, 0.7);
+  out.chill_dance_bottle = danceBounce(1, 0.75, { hold: 'bottle' });
+  out.chill_counter_back_1 = counterBack(1);
+  out.chill_counter_back_2 = counterBack(2);
+  out.chill_counter_back_bottle = counterBack(1, { hold: 'bottle' });
+  out.chill_counter_lean = counterLean();
+  out.chill_window_1 = windowLook(1);
+  out.chill_window_2 = windowLook(2);
+  out.chill_window_bottle = windowLook(1, { hold: 'bottle' });
+  out.chill_rail_1 = railLean(1);
+  out.chill_rail_2 = railLean(2);
+  out.chill_stand_drink_1 = standDrink(1);
+  out.chill_stand_drink_2 = standDrink(2);
+  out.chill_stand_drink_cup = standDrink(1, 'cup');
+  out.chill_stand_talk = standTalk('talk');
+  out.chill_stand_talk_bottle = standTalk('talk', { hold: 'bottle' });
+  out.chill_stand_listen = standTalk('listen');
+  out.chill_stand_listen_bottle = standTalk('listen', { hold: 'bottle' });
+  out.chill_stand_dap = standDap();
+  out.chill_console = consolePick();
+  const all = { ...bases, ...out };
+  out.chill_stretch = stretchYawn(all);
+  out.chill_fridge_grab = fridgeGrab(all);
+  return out;
+}
+
+const IDLE_BASE = {
+  idle: {
+    duration: 4,
+    sample: (L, t) => {
+      const p = base(L, { armDown: 23, elbow: 12 });
+      Pose.headNod(p, 2);
+      p.hips.set(0, -0.006, 0);
+      const ankles = Object.fromEntries(SIDES.map((s) => [s, L.world[`${s}Foot`].clone()]));
+      plantFeet(L, p, { ankles });
+      return p;
+    },
+  },
+};
+
+/** The chill samplers. Built on the live registry's idle when registered; standalone otherwise. */
+export const CHILL_SAMPLERS = makeChillSamplers(IDLE_BASE);
+export const CHILL_CLIP_NAMES = Object.keys(CHILL_SAMPLERS);
+
+/**
+ * Hands the samplers to a registry (clips.js registerSamplers, which passes the live bases when
+ * given a factory). Already-registered names are skipped. Returns true when registered.
+ */
+export function registerChillClips(register) {
+  if (typeof register !== 'function') return false;
+  register((bases) => {
+    const made = makeChillSamplers(bases);
+    for (const name of Object.keys(made)) if (bases[name]) delete made[name];
+    Object.assign(CHILL_SAMPLERS, made);
+    return made;
+  });
+  return true;
+}
+
+/** Bakes one chill sampler into a THREE.AnimationClip (same track layout as clips.js bakeClip). */
+export function bakeChillClip(layout, name, { prefix = '', samplers = CHILL_SAMPLERS } = {}) {
+  const s = samplers[name];
+  if (!s) throw new Error(`Unknown chill clip ${name}`);
+  const frames = Math.round(s.duration * FPS);
+  const times = new Float32Array(frames + 1);
+  const quats = Object.fromEntries(JOINTS.map(([j]) => [j, new Float32Array((frames + 1) * 4)]));
+  const hipPos = new Float32Array((frames + 1) * 3);
+  const restHips = layout.world.Hips;
+  for (let f = 0; f <= frames; f++) {
+    const t = s.loop && f === frames ? 0 : Math.min(f / FPS, s.duration);
+    times[f] = f / FPS;
+    const pose = relaxHands(s.sample(layout, t, s.duration), layout);
+    for (const [j] of JOINTS) (pose.bones[j] ?? new THREE.Quaternion()).toArray(quats[j], f * 4);
+    hipPos[f * 3] = restHips.x + pose.hips.x;
+    hipPos[f * 3 + 1] = restHips.y + pose.hips.y;
+    hipPos[f * 3 + 2] = restHips.z + pose.hips.z;
+  }
+  const tracks = JOINTS.map(([j]) => new THREE.QuaternionKeyframeTrack(`${prefix}${j}.quaternion`, times, quats[j]));
+  tracks.push(new THREE.VectorKeyframeTrack(`${prefix}Hips.position`, times, hipPos));
+  const clip = new THREE.AnimationClip(name, s.duration, tracks);
+  clip.userData = { loop: s.loop, chill: true, ...(s.meta ? s.meta(layout) : {}), ...(s.events ? { events: s.events } : {}) };
+  return clip;
+}
+
+/** Bakes every chill clip (or `names`) for a layout: { name: AnimationClip }. */
+export function bakeChillClips(layout, { names = CHILL_CLIP_NAMES, prefix = '' } = {}) {
+  return Object.fromEntries(names.map((n) => [n, bakeChillClip(layout, n, { prefix })]));
+}
