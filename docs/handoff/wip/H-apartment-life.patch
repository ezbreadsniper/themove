@@ -0,0 +1,1342 @@
+import * as THREE from 'three';
+import { JOINTS } from '../rig/skeleton.js';
+import { Pose, curlFingers, relaxHands } from './pose.js';
+import { FPS, TAU, SIDES, ease, window01, base, plantFeet, bump, envelope } from './clip-kit.js';
+import { worldPose } from './fk.js';
+import { reach, handTargetAt } from './reach.js';
+import { solveTwoBone, handRotation, handGripOffset } from './arm-ik.js';
+import { legRig, rolledAnkle } from './ik.js';
+import { footRotation } from './clip-kit.js';
+import { SEATS, SIT_DROP } from './action-clips.js';
+
+/**
+ * Apartment "chill" clips (names prefixed `chill_`): sitting on the loft sofa / chairs listening to
+ * music, drinking, talking, scrolling a phone, gaming; dancing, leaning on the counter or the
+ * mezzanine rail, looking out of the window, stretching. Same sampler shape as clips.js:
+ * { duration, loop, events?, meta?, sample(L, t, dur) → Pose }, character space (feet on y = 0,
+ * facing +Z, +X = the character's left).
+ *
+ * Music: loops are whole bars of a 128 BPM track (BEAT s per beat) and say so in meta.beats, so the
+ * activity layer can phase-lock them to the music clock (head nods land on the kick). Variations
+ * (`_1`, `_2`, ...) differ in posture, energy and groove (on-beat vs half-time nods, foot taps, knee
+ * bounce, drumming) so five people on one sofa never move in sync.
+ *
+ * Seating follows action-clips.js: seat heights are absolute (FURNITURE), the pelvis settles
+ * SEATS[variant].hipsBack × k behind the root and the hip joints SIT_DROP × k above the seat, so
+ * sitDown_sofa → chill_sit_* → standUp_sofa blend without a pop. The sofa back cushion sits
+ * SOFA_BACK.face behind the seat point (where the pelvis is), its top SOFA_BACK.top above the floor.
+ *
+ * Held props are posed through PROP_GRIPS: each prop has a local frame and, per hand, the grip point
+ * plus the hand's finger / palm directions in that frame. Clips place a prop frame in the world and
+ * solve the hand onto it; propAttachment() gives the inverse (prop offset in the hand bone) so the
+ * mesh in src/npc/activities/props.js lands exactly where the clip held it.
+ */
+
+export const BPM = 128;
+export const BEAT = 60 / BPM;
+export const SOFA_BACK = Object.freeze({ face: 0.255, top: 0.78 });
+/** Counter / rail heights the standing clips assume (m above the floor, absolute). */
+export const COUNTER = Object.freeze({ top: 0.91, behind: 0.21, front: 0.3 });
+export const RAIL = Object.freeze({ top: 1.05, front: 0.3 });
+
+const V = (x, y, z) => new THREE.Vector3(x, y, z);
+const kOf = (L) => L.measures.height / 1.78;
+const S = { Left: 1, Right: -1 };
+const frac = (x) => x - Math.floor(x);
+const sinB = (b, period, ph = 0) => Math.sin(((b / period) + ph) * TAU);
+const OTHER = { Left: 'Right', Right: 'Left' };
+
+/**
+ * Groove pulse over beats: 1 on the beat (b integer), a quick attack into it and a slower release,
+ * 0 at the far point. `period` in beats (2 = half time), `delay` shifts it (beats, + = later).
+ */
+export function pulse(b, { period = 1, delay = 0, attack = 0.24 } = {}) {
+  const x = frac((b - delay) / period + attack);
+  return x < attack ? ease(x / attack) : 1 - ease((x - attack) / (1 - attack));
+}
+
+// --- props --------------------------------------------------------------------------------------
+
+/**
+ * Prop frames (local, metres). bottle / cup: origin at the base, +Y up the axis, the hand on the −Z
+ * side. phone: origin at the centre, +Y toward the top edge, +Z the screen normal. controller: origin
+ * at the centre, +Z away from the player, +Y the face with the sticks, +X the player's left.
+ * grip[side] = { pos, fingers, palm } (directions in the prop frame; palm points from the hand into the prop).
+ */
+export const PROP_GRIPS = {
+  bottle: {
+    height: 0.235, radius: 0.031, lip: [0, 0.235, 0],
+    grip: {
+      Right: { pos: [0, 0.07, -0.036], fingers: [-1, 0, 0], palm: [0, 0, 1] },
+      Left: { pos: [0, 0.07, -0.036], fingers: [1, 0, 0], palm: [0, 0, 1] },
+    },
+  },
+  cup: {
+    height: 0.12, radius: 0.045, lip: [0, 0.12, 0],
+    grip: {
+      Right: { pos: [0, 0.06, -0.05], fingers: [-1, 0, 0], palm: [0, 0, 1] },
+      Left: { pos: [0, 0.06, -0.05], fingers: [1, 0, 0], palm: [0, 0, 1] },
+    },
+  },
+  phone: {
+    size: [0.07, 0.145, 0.009],
+    grip: {
+      Right: { pos: [0.012, -0.03, -0.018], fingers: [-1, 0.15, 0], palm: [0, 0, 1] },
+      Left: { pos: [-0.012, -0.03, -0.018], fingers: [1, 0.15, 0], palm: [0, 0, 1] },
+    },
+  },
+  controller: {
+    size: [0.155, 0.05, 0.1],
+    grip: {
+      Right: { pos: [-0.07, -0.02, -0.035], fingers: [0.35, -0.75, 0.55], palm: [0.75, 0.55, 0.1] },
+      Left: { pos: [0.07, -0.02, -0.035], fingers: [-0.35, -0.75, 0.55], palm: [-0.75, 0.55, 0.1] },
+    },
+  },
+};
+
+const v3 = (a) => new THREE.Vector3(...a);
+
+/** Orthonormalised hand frame for a prop grip (palm made perpendicular to fingers). */
+function gripDirs(kind, side) {
+  const g = PROP_GRIPS[kind].grip[side];
+  const fingers = v3(g.fingers).normalize();
+  const palm = v3(g.palm).addScaledVector(fingers, -v3(g.palm).dot(fingers)).normalize();
+  return { pos: v3(g.pos), fingers, palm };
+}
+
+/** World frame of a prop: origin + quaternion from its local +Y axis and the side the hand is on (−Z). */
+export function propFrame(origin, up, towardHand) {
+  const y = up.clone().normalize();
+  const z = towardHand.clone().multiplyScalar(-1);
+  z.addScaledVector(y, -z.dot(y));
+  if (z.lengthSq() < 1e-8) z.set(0, 0, 1).addScaledVector(y, -y.z);
+  z.normalize();
+  const x = y.clone().cross(z).normalize();
+  const m = new THREE.Matrix4().makeBasis(x, y, z);
+  return { pos: origin.clone(), quat: new THREE.Quaternion().setFromRotationMatrix(m) };
+}
+
+/** Hand target (for reach) gripping prop `kind` placed at frame { pos, quat }. */
+export function propGrip(L, side, kind, frame, pole) {
+  const g = gripDirs(kind, side);
+  const grip = g.pos.clone().applyQuaternion(frame.quat).add(frame.pos);
+  return handTargetAt(L, side, grip, g.fingers.clone().applyQuaternion(frame.quat), g.palm.clone().applyQuaternion(frame.quat), pole);
+}
+
+/**
+ * Where prop `kind` sits in a hand bone's local frame when that hand grips it: { position, quaternion }.
+ * The inverse of propGrip (hand bones rest at identity, so bone-local = rest world axes).
+ */
+export function propAttachment(L, kind, side = 'Right') {
+  const g = gripDirs(kind, side);
+  const handInProp = handRotation(L, side, g.fingers, g.palm);
+  const quaternion = handInProp.clone().invert();
+  const position = handGripOffset(L, side).sub(g.pos.clone().applyQuaternion(quaternion));
+  return { position, quaternion };
+}
+
+// --- body helpers -------------------------------------------------------------------------------
+
+const POLE = { Left: V(0.7, -1, -0.25), Right: V(-0.7, -1, -0.25) };
+
+/** Mouth (lip surface) in character space for the posed head. */
+export function mouthPoint(L, fk) {
+  const kh = L.measures.headHeight / 0.24;
+  return fk.pos.Head.clone().add(V(0, 0.028 * kh, 0.1 * kh).applyQuaternion(fk.quat.Head));
+}
+
+/** Ankle target for a foot pitched about its heel (pitch > 0, toes up) or ball (pitch < 0, heel up). */
+function rolled(L, side, ankle, pitch, yawDeg = 0) {
+  if (!pitch) return ankle;
+  const rig = legRig(L, side);
+  const { offset } = rolledAnkle(rig, pitch, THREE.MathUtils.degToRad(yawDeg * S[side]));
+  return ankle.clone().add(offset);
+}
+
+/** Re-solves one leg to an ankle target with an explicit world foot rotation (crossed legs). */
+function legTo(L, p, side, ankle, footQ, pole) {
+  const fk = worldPose(L, p);
+  const r = solveTwoBone(L, [`${side}UpLeg`, `${side}Leg`, `${side}Foot`], fk.pos[`${side}UpLeg`], fk.quat.Hips, ankle, footQ, pole.clone().normalize(), V(0, 0, 1));
+  p.bones[`${side}UpLeg`] = r.upper;
+  p.bones[`${side}Leg`] = r.lower;
+  p.bones[`${side}Foot`] = r.end;
+}
+
+/** Spreads a forward flex over the spine (Spine, Spine1, Spine2) with a neck share. */
+function flexSpine(p, deg, { neck = 0 } = {}) {
+  Pose.spineFlex(p, 'Spine', deg * 0.4);
+  Pose.spineFlex(p, 'Spine1', deg * 0.35);
+  Pose.spineFlex(p, 'Spine2', deg * 0.25);
+  if (neck) Pose.spineFlex(p, 'Neck', neck);
+}
+
+function twistSpine(p, deg) {
+  Pose.spineTwist(p, 'Spine', deg * 0.25);
+  Pose.spineTwist(p, 'Spine1', deg * 0.35);
+  Pose.spineTwist(p, 'Spine2', deg * 0.4);
+}
+
+/**
+ * Head groove: torso leads, neck and head follow a touch later (follow-through), all on the beat.
+ * amt = nod depth (deg at the head), b = beat time.
+ */
+function groove(p, b, amt, { period = 1, follow = 1, attack = 0.24, phase = 0 } = {}) {
+  if (!amt) return;
+  const at = (d) => pulse(b, { period, delay: d + phase, attack });
+  Pose.spineFlex(p, 'Spine1', amt * 0.12 * follow * at(-0.04));
+  Pose.spineFlex(p, 'Spine2', amt * 0.18 * follow * at(-0.02));
+  Pose.spineFlex(p, 'Neck', amt * 0.35 * at(0));
+  Pose.headNod(p, amt * 0.6 * at(0.035));
+}
+
+/** Shoulders bounce up on the off-beat (both, or alternating with `alt`). */
+function shoulderBounce(p, b, amt, { alt = false } = {}) {
+  if (!amt) return;
+  for (const side of SIDES) {
+    const d = alt ? (side === 'Left' ? 0 : 1) : 0;
+    Pose.shoulderShrug(p, side, amt * pulse(b, { period: alt ? 2 : 1, delay: 0.5 + d, attack: 0.3 }));
+  }
+}
+
+function breathe(p, b, amt = 1) {
+  const br = Math.sin((b / 8) * TAU) * amt;
+  Pose.spineFlex(p, 'Spine1', -br * 0.7);
+  Pose.spineFlex(p, 'Spine2', -br * 0.5);
+  return br;
+}
+
+function talkJaw(p, t, amt = 1) {
+  const syll = Math.abs(Math.sin(t * 9.4)) * (0.55 + 0.45 * Math.sin(t * 2.2 + 1));
+  Pose.jawOpen(p, 0.5 + syll * 11 * amt);
+}
+
+/**
+ * Seated body: pelvis on the seat (sofa recline rolls it back), spine, head and legs. Arms are left
+ * at the base and placed by the caller. o:
+ *   variant 'sofa' | 'chair'; recline (deg, pelvis roll back; default the seat's), lean (trunk
+ *   forward deg), comp (0..1 how much of the recline the spine curls back up), twist (deg toward the
+ *   character's left +), side (trunk side bend deg), look / headPitch / headTilt (deg), breath;
+ *   legs: { Left|Right: { fwd, out, lift, yaw, heel (deg, heel up on the ball), toe (deg, toes up) } };
+ *   cross: 'Left' | 'Right' → that ankle rests on the other knee (figure four);
+ *   ankles: 'Left' | 'Right' → legs out, that ankle crossed over the other.
+ */
+export function sitBody(L, o = {}) {
+  const kk = kOf(L);
+  const variant = o.variant ?? 'sofa';
+  const seat = SEATS[variant];
+  const p = base(L, { armDown: 18, elbow: 28 });
+  const recline = o.recline ?? seat.recline;
+  const lean = o.lean ?? 0;
+  const comp = o.comp ?? 0.6;
+  Pose.rootPitch(p, -recline + lean * 0.35);
+  flexSpine(p, lean * 0.65 + recline * comp);
+  if (o.twist) twistSpine(p, o.twist);
+  if (o.side) {
+    Pose.spineSide(p, 'Spine1', o.side * 0.5);
+    Pose.spineSide(p, 'Spine2', o.side * 0.5);
+  }
+  const br = o.breath ?? 0;
+  Pose.spineFlex(p, 'Spine1', -br * 0.7);
+  Pose.spineFlex(p, 'Spine2', -br * 0.5);
+  Pose.headNod(p, 2 - lean * 0.45 + recline * (0.5 - comp * 0.5) * 0.6 + (o.headPitch ?? 0));
+  if (o.look) {
+    Pose.spineFlex(p, 'Neck', 0);
+    Pose.headTurn(p, o.look);
+  }
+  if (o.headTilt) Pose.headTilt(p, o.headTilt);
+  p.hips.set(0, -0.006 * kk, -seat.hipsBack * kk);
+  const fk = worldPose(L, p);
+  const jointY = (fk.pos.LeftUpLeg.y + fk.pos.RightUpLeg.y) / 2;
+  p.hips.y += seat.height + SIT_DROP * kk - jointY + 0.0012 * kk * br;
+
+  const ankles = {};
+  const feet = {};
+  const legs = o.legs ?? {};
+  for (const side of SIDES) {
+    const s = S[side];
+    const g = legs[side] ?? {};
+    const yaw = g.yaw ?? 8;
+    let a = L.world[`${side}Foot`].clone().add(V(s * (seat.spread + (g.out ?? 0)) * kk, (g.lift ?? 0) * kk, (seat.ankleFwd + (g.fwd ?? 0)) * kk));
+    const pitch = (g.toe ?? 0) - (g.heel ?? 0);
+    a = rolled(L, side, a, pitch, yaw);
+    ankles[side] = a;
+    feet[side] = { yaw, pitch };
+  }
+  if (o.ankles) {
+    // Legs stretched out, ankles crossed: the top ankle sits on the other's instep.
+    const top = o.ankles;
+    const under = OTHER[top];
+    ankles[under] = L.world[`${under}Foot`].clone().add(V(S[under] * 0.02 * kk, 0, (seat.ankleFwd + 0.24) * kk));
+    feet[under] = { yaw: 10, pitch: 14 };
+    ankles[under] = rolled(L, under, ankles[under], 14, 10);
+    ankles[top] = ankles[under].clone().add(V(S[under] * 0.035 * kk, 0.075 * kk, 0.02 * kk));
+    feet[top] = { yaw: -6, pitch: 22 };
+  }
+  plantFeet(L, p, { ankles, feet, kneeOut: o.kneeOut ?? 0.35 });
+  if (o.cross) {
+    // Figure four: the crossing ankle on top of the other knee, knee dropped out to the side.
+    const c = o.cross;
+    const s = S[c];
+    const fk2 = worldPose(L, p);
+    const knee = fk2.pos[`${OTHER[c]}Leg`];
+    const ankle = knee.clone().add(V(s * 0.05 * kk, L.measures.thighRadius * 0.9 + L.measures.ankleRadius * 1.1, -0.06 * kk));
+    const footQ = new THREE.Quaternion().setFromEuler(new THREE.Euler(THREE.MathUtils.degToRad(-8), THREE.MathUtils.degToRad(-s * 78), THREE.MathUtils.degToRad(s * 28), 'YXZ'));
+    legTo(L, p, c, ankle, footQ, V(s * 1.6, 0.35, 0.6));
+  }
+  return p;
+}
+
+/** Hand resting on the top of a thigh, fingers toward the knee (drum: fingertip tap lift). */
+function thighHand(L, p, side, { along = 0.64, out = 0, lift = 0, inward = 0 } = {}) {
+  const kk = kOf(L);
+  const fk = worldPose(L, p);
+  const s = S[side];
+  const hip = fk.pos[`${side}UpLeg`];
+  const knee = fk.pos[`${side}Leg`];
+  const grip = hip.clone().lerp(knee, along).add(V(s * (out - 0.012 * kk) - s * inward, L.measures.thighRadius * 0.95 + 0.012 * kk + lift, 0));
+  const fingers = knee.clone().sub(hip).normalize().add(V(-s * (0.15 + inward * 2), -0.25 + lift * 4, 0)).normalize();
+  return handTargetAt(L, side, grip, fingers, V(-s * 0.15, -1, 0), V(s * 0.9, -0.3, -0.8));
+}
+
+/** Arm laid along the sofa back: forearm on the top of the back cushion, hand draped over it. */
+function sofaBackHand(L, p, side, { out = 0.62, back = 0.07, drop = 0 } = {}) {
+  const kk = kOf(L);
+  const s = S[side];
+  const z = L.world.Hips.z + p.hips.z - SOFA_BACK.face - back;
+  const grip = V(s * out * kk, SOFA_BACK.top + 0.045 - drop, z);
+  return handTargetAt(L, side, grip, V(s * 0.55, -0.55, -0.6), V(-s * 0.2, -1, 0.3), V(s * 0.35, 0.35, -1));
+}
+
+/** Both hands loosely clasped on the lap (or belly with `high`). */
+function lapHands(L, p, { high = 0, fwd = 0 } = {}) {
+  const kk = kOf(L);
+  const fk = worldPose(L, p);
+  const mid = fk.pos.LeftUpLeg.clone().lerp(fk.pos.RightUpLeg, 0.5);
+  const kneeMid = fk.pos.LeftLeg.clone().lerp(fk.pos.RightLeg, 0.5);
+  const c = mid.clone().lerp(kneeMid, 0.3 + fwd).add(V(0, L.measures.thighRadius * 1.25 + 0.02 * kk + high * 0.16 * kk, high * -0.06 * kk));
+  return {
+    Right: handTargetAt(L, 'Right', c.clone().add(V(-0.035 * kk, 0.015 * kk, 0.01 * kk)), V(0.85, -0.2, 0.35), V(0.2, -1, -0.1), V(-0.8, -0.6, -0.3)),
+    Left: handTargetAt(L, 'Left', c.clone().add(V(0.035 * kk, -0.005 * kk, -0.005 * kk)), V(-0.85, -0.25, 0.35), V(-0.2, -1, -0.15), V(0.8, -0.6, -0.3)),
+  };
+}
+
+/** Leaning forward with the forearms on the thighs: hands hang / clasp between the knees. */
+function kneesHands(L, p, { clasp = 1, spread = 0 } = {}) {
+  const kk = kOf(L);
+  const fk = worldPose(L, p);
+  const kneeMid = fk.pos.LeftLeg.clone().lerp(fk.pos.RightLeg, 0.5);
+  const c = kneeMid.clone().add(V(0, -0.02 * kk, 0.06 * kk));
+  const out = {};
+  for (const side of SIDES) {
+    const s = S[side];
+    const at = c.clone().add(V(s * (0.03 + spread) * kk, s > 0 ? -0.01 * kk : 0.005 * kk, 0));
+    out[side] = handTargetAt(L, side, at, V(-s * (0.6 + 0.3 * clasp), -0.6, 0.45), V(-s * 0.3, -0.4, -1), V(s * 0.6, -1, -0.5));
+  }
+  return out;
+}
+
+/** Hand in the front trouser pocket. */
+function pocketHand(L, p, side) {
+  const kk = kOf(L);
+  const fk = worldPose(L, p);
+  const s = S[side];
+  const hip = fk.pos[`${side}UpLeg`];
+  const at = hip.clone().add(V(s * 0.065 * kk, -0.02 * kk, 0.075 * kk));
+  return handTargetAt(L, side, at, V(s * 0.15, -1, 0.35), V(-s, 0, 0.1), V(s * 0.4, -0.3, -1));
+}
+
+/** Prop frame for a bottle held upright in front of the body at `at` (hand on the given side). */
+function heldFrame(side, at, { tilt = 0, out = 0.4 } = {}) {
+  const s = S[side];
+  const up = V(-s * tilt * 0.3, 1, tilt).normalize();
+  return propFrame(at, up, V(s * out, 0, -1));
+}
+
+/** Frame for drinking: bottle lip at the mouth, tipped by `tip` degrees past horizontal toward the face. */
+function sipFrame(L, fk, kind, tip, side) {
+  const s = S[side];
+  const g = PROP_GRIPS[kind];
+  const mouth = mouthPoint(L, fk);
+  const headQ = fk.quat.Head;
+  const fwd = V(0, 0, 1).applyQuaternion(headQ);
+  const upH = V(0, 1, 0).applyQuaternion(headQ);
+  const a = THREE.MathUtils.degToRad(90 + tip);
+  // Axis (base → lip) points back toward the face and down by `tip`.
+  const axis = fwd.clone().multiplyScalar(-Math.sin(a)).addScaledVector(upH, Math.cos(a)).normalize();
+  const lip = mouth.clone().addScaledVector(fwd, 0.006);
+  const origin = lip.clone().addScaledVector(axis, -g.lip[1]);
+  return propFrame(origin, axis, V(s * 0.9, -0.4, 0).add(fwd.clone().multiplyScalar(-0.2)));
+}
+
+/** Bottle resting on a thigh near the knee, hand around it. */
+function kneeBottleFrame(L, p, side, { along = 0.8 } = {}) {
+  const kk = kOf(L);
+  const fk = worldPose(L, p);
+  const s = S[side];
+  const hip = fk.pos[`${side}UpLeg`];
+  const knee = fk.pos[`${side}Leg`];
+  const at = hip.clone().lerp(knee, along).add(V(-s * 0.01 * kk, L.measures.thighRadius * 0.92 + 0.004, 0));
+  return propFrame(at, V(-s * 0.06, 1, -0.08), V(s * 0.75, 0, -0.65));
+}
+
+/** A whole-body sip: lift, tip (head back), hold, lower. Returns { u (0 rest → 1 at lips), tip, head }. */
+function sipCurve(b, start, len = 6) {
+  const up = ease(window01(b, start, start + 1.4));
+  const down = ease(window01(b, start + len - 1.6, start + len));
+  const u = up * (1 - down);
+  const tipping = ease(window01(b, start + 1.1, start + 2.2)) * (1 - ease(window01(b, start + len - 2.2, start + len - 1.3)));
+  return { u, tip: 8 + 30 * tipping, head: -14 * tipping };
+}
+
+/**
+ * Bottle hand: from a rest frame to the lips by `s.u` (with the head tilt in s.head already applied
+ * to the pose). Writes the arm; returns the target used.
+ */
+function bottleArm(L, p, side, restFrame, sip, kind = 'bottle') {
+  const rest = propGrip(L, side, kind, restFrame, POLE[side]);
+  if (!sip || sip.u <= 0.001) {
+    reach(L, p, side, null, rest, 1);
+    return rest;
+  }
+  const fk = worldPose(L, p);
+  const lips = propGrip(L, side, kind, sipFrame(L, fk, kind, sip.tip, side), V(S[side] * 0.9, -0.8, -0.1));
+  reach(L, p, side, rest, lips, sip.u, { arc: V(S[side] * 0.03, 0.03, 0.06) });
+  return lips;
+}
+
+function gripCurl(p, L, side, kind) {
